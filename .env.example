# ============================================================
# .env.example —— 环境变量样板（可以提交到仓库，里面没有任何真实值）
# 用法：复制成 .env 再填自己的值；.env 已被 .gitignore 拦截，永远不会上传
#   copy .env.example .env      （Windows CMD）
#   cp .env.example .env        （PowerShell / Git Bash）
# ============================================================

# ---- 云函数 photos-api 用到的（真实值只配在 CloudBase 控制台）----

# 环境 ID：控制台首页右上角「环境ID」，形如 myself-demo-xxxxxxxx
TCB_ENV_ID=你的环境ID

# 服务端 API Key（service_role 级别，权限很高）：控制台 → 环境 → 密钥管理 → API Key
# 注意：这个 Key 能读写整库，只能放服务端；绝不能写进 client/ 下的任何文件
TCB_API_KEY=你的API_KEY

# 静态托管域名：用来把库里的 /public/assets/... 拼成完整图片 URL
# 形如 https://你的环境ID.tcloudbaseapp.com（结尾不要带 /）
SITE_ORIGIN=https://你的环境ID.tcloudbaseapp.com

# 跨域白名单：逗号分隔，禁止写 *
# 线上域名 + 本地调试地址，两个都要写，否则本地页面调不通
CORS_ORIGIN=https://你的环境ID.tcloudbaseapp.com,http://localhost:8000

# ---- 仅本地测试用，生产环境不要设 ----
# 把数据通道指向本地假上游（见会话工作区的 day23-error-check.js）
# REST_BASE=http://127.0.0.1:8787

# 云函数监听端口，CloudBase 会自动注入，本地缺省 9000
# PORT=9000


# ---- 云函数 health 用到的 ----
# 只有 CORS_ORIGIN 和 PORT，含义同上
